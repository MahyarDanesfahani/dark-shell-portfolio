PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
DATABASE_URL=postgresql://user:password@localhost:5432/dark_shell
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
DATABASE_SSL=false
# Keep true in production unless your managed database explicitly requires otherwise.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# SMTP is optional for local development; configure all required values in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=you@example.com
